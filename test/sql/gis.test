# name: test/sql/gis.test
# description: smoke-test the duckdb-gis extension launch verbs
# group: [sql]

require gis

# Keep the test hermetic: bind to a non-default port and never open a browser.
# Use the *_server verb (not start_gis, which tries to launch a browser via
# the system() "open" command).

# Nothing running yet.
query I
FROM gis_is_started();
----
false

# Start the server. The status string embeds the local URL on our chosen port.
query I
SELECT result LIKE 'duckdb-gis server %started at http://localhost:42131/' FROM start_gis_server(port := 42131);
----
true

query I
FROM gis_is_started();
----
true

# get_gis_url returns the plain local URL.
query I
FROM get_gis_url();
----
http://localhost:42131/

# Starting again is idempotent: reports "already started", still one server
# (on its original port, whatever port is passed now).
query I
SELECT result LIKE 'duckdb-gis server already started at http://localhost:42131/' FROM start_gis_server(port := 42132);
----
true

# Stop cleanly.
query I
FROM stop_gis_server();
----
duckdb-gis server stopped

query I
FROM gis_is_started();
----
false

# Stopping again is idempotent.
query I
FROM stop_gis_server();
----
duckdb-gis server already stopped

# get_gis_url needs a running server.
statement error
FROM get_gis_url();
----
duckdb-gis server not started

# The port must be a valid TCP port.
statement error
FROM start_gis_server(port := 70000);
----
port must be between 1 and 65535
